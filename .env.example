APP_ENV=dev
LOG_LEVEL=INFO

# Market data
SYMBOL=BTCUSDT
BINANCE_ENV=LIVE
RECORD_RAW_WS=true
CONSUME_DEPTH_STREAM=true
RECORD_DEPTH_STREAM=false
DEPTH_LEVELS=5
CONSUME_LIQUIDATION_STREAM=true
RECORD_BOOK_TICKER_MIN_INTERVAL_MS=250
RAW_ROTATION_MINUTES=60
COMPRESS_ROTATED_RAW=true
WRITE_FEATURE_LOG=true
WRITE_DECISION_LOG=true
WRITE_PAPER_TRADE_LOG=true
WRITE_SHADOW_TRADE_LOG=true
WRITE_REGIME_OUTCOME_LOG=true
DATA_DIR=data
STATE_WINDOW_SECONDS=900
STALE_AFTER_SECONDS=2.0
OPEN_INTEREST_POLL_SECONDS=30

# Strategy cadence
DECISION_INTERVAL_MS=500
MIN_WARMUP_SECONDS=180
STRATEGY_VARIANT=baseline
ENABLE_MARKOV_STATE_MACHINE=true
MARKOV_STATE_HISTORY=8
SESSION_BIAS_SIDE=neutral
SESSION_BIAS_STRENGTH=0.0
SESSION_BIAS_REASON=
FAST_TARGET_MOVE_PCT=0.002
FAST_STOP_MOVE_PCT=0.0015
SLOW_TARGET_MOVE_PCT=0.0035
SLOW_STOP_MOVE_PCT=0.0035
STATEFUL_TARGET_FEASIBILITY_FRACTION=0.60
STATEFUL_ADAPTIVE_TARGET_FRACTION=0.50
STATEFUL_ADAPTIVE_MIN_SEQUENCE_CONFIDENCE=0.93
STATEFUL_ADAPTIVE_MIN_SCORE=0.70
STATEFUL_ADAPTIVE_MIN_QUALITY_LONG=0.74
STATEFUL_ADAPTIVE_MIN_QUALITY_SHORT=0.68
STATEFUL_ADAPTIVE_TARGET_MOVE_PCT=0.0020
STATEFUL_ADAPTIVE_STOP_MOVE_PCT=0.0015
HIGHER_TIMEFRAME_EXECUTION_GATE_ENABLED=true
HIGHER_TIMEFRAME_GATE_MIN_STRENGTH=0.35
HIGHER_TIMEFRAME_COUNTERTREND_MIN_QUALITY=0.86
HIGHER_TIMEFRAME_COUNTERTREND_MIN_SCORE=0.82
HIGHER_TIMEFRAME_COUNTERTREND_MIN_SEQUENCE_CONFIDENCE=0.96
HIGHER_TIMEFRAME_EXCEPTION_TARGET_MOVE_PCT=0.0035
HIGHER_TIMEFRAME_STRONG_EXCEPTION_TARGET_MOVE_PCT=0.005
COUNTER_HTF_BOUNCE_ENABLED=true
COUNTER_HTF_BOUNCE_SYMBOLS=ETHUSDT
COUNTER_HTF_BOUNCE_MIN_QUALITY=0.74
COUNTER_HTF_BOUNCE_MIN_SCORE=0.74
COUNTER_HTF_BOUNCE_MIN_SEQUENCE_CONFIDENCE=0.90
COUNTER_HTF_BOUNCE_MIN_RANGE_PCT=0.0020
LOCAL_EXECUTION_GATE_ENABLED=true
LOCAL_5M_COUNTERTREND_TREND_THRESHOLD=0.45
LOCAL_REVERSAL_RETURN_15S_PCT=0.00035
LOCAL_REVERSAL_RETURN_60S_PCT=0.00060
LOCAL_REVERSAL_PRESSURE=0.08
MIN_GROSS_TARGET_FEE_MULTIPLE=2.0
REGIME_OUTCOME_HORIZONS_SECONDS=15,30,60,180,300,900
REGIME_OUTCOME_TARGET_MOVES_PCT=0.001,0.002,0.0035,0.005
REGIME_OUTCOME_STOP_MOVES_PCT=0.001,0.002
REGIME_OUTCOME_COOLDOWN_SECONDS=900
REGIME_OUTCOME_EARLY_HORIZONS_SECONDS=15,30,60
REGIME_OUTCOME_MIN_EARLY_CORRECT=2
MAX_SPREAD_BPS=2.0
MIN_CONFIDENCE=0.72
ENABLE_PRICE_STOP=true
EMERGENCY_MAX_ADVERSE_MOVE_PCT=0.004
MAX_POSITION_SECONDS=0
MAX_SHORT_TAKER_BUY_RATIO_30S=0.60
ENABLE_FAST_FAILURE_EXIT=false
FAST_FAILURE_SECONDS=180
FAST_FAILURE_MIN_FAVORABLE_MOVE_PCT=0.0005
TRADE_COOLDOWN_SECONDS=1800

# Leverage/stake model. This is paper/sim by default, not live execution.
ACCOUNT_EQUITY_USD=1000
STAKE_FRACTION=0.15
FAST_LEVERAGE=200
SLOW_LEVERAGE=80
TAKER_FEE_BPS=4.0
DAILY_TARGET_USD=150
DAILY_MAX_LOSS_USD=75
MAX_TRADES_PER_DAY=1

# API auth. Set this before exposing the service outside localhost.
API_TOKEN=

# Future NautilusTrader/demo/live integration. Do not commit real keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=
