APP_ENV=prod
LOG_LEVEL=INFO

# Lightsail/Tokyo is the recommended first AWS target for this project.
AWS_REGION=ap-northeast-1
LIGHTSAIL_SERVICE_NAME=futures-lab
LIGHTSAIL_POWER=medium
LIGHTSAIL_SCALE=1
LIGHTSAIL_IMAGE_LABEL=futures-lab

# Market data
SYMBOL=ETHUSDT
BINANCE_ENV=LIVE
RECORD_RAW_WS=true
CONSUME_DEPTH_STREAM=true
RECORD_DEPTH_STREAM=false
DEPTH_LEVELS=5
CONSUME_LIQUIDATION_STREAM=true
RECORD_BOOK_TICKER_MIN_INTERVAL_MS=250
RAW_ROTATION_MINUTES=60
COMPRESS_ROTATED_RAW=true
WRITE_FEATURE_LOG=true
WRITE_DECISION_LOG=true
WRITE_PAPER_TRADE_LOG=true
WRITE_SHADOW_TRADE_LOG=true
WRITE_REGIME_OUTCOME_LOG=true
WRITE_CANDIDATE_OUTCOME_LOG=true
DATA_DIR=/app/data
STATE_WINDOW_SECONDS=900
STALE_AFTER_SECONDS=2.0
OPEN_INTEREST_POLL_SECONDS=30
HIGHER_TIMEFRAME_ENABLED=true
HIGHER_TIMEFRAME_INTERVALS=5m,1h,4h,1d,1w
HIGHER_TIMEFRAME_EXECUTION_GATE_ENABLED=true
CROSS_MARKET_ENABLED=true
CROSS_MARKET_ANCHOR_SYMBOL=BTCUSDT

# Strategy
DECISION_INTERVAL_MS=500
MIN_WARMUP_SECONDS=180
STRATEGY_VARIANT=stateful_momentum
ENABLE_MARKOV_STATE_MACHINE=true
MARKOV_STATE_HISTORY=8
FAST_TARGET_MOVE_PCT=0.005
FAST_STOP_MOVE_PCT=0.002
SLOW_TARGET_MOVE_PCT=0.008
SLOW_STOP_MOVE_PCT=0.0035
MAX_SPREAD_BPS=2.0
MIN_CONFIDENCE=0.72
ENTRY_FOLLOW_THROUGH_GATE_ENABLED=true
ENTRY_FOLLOW_THROUGH_MIN_SCORE=0.68
ENTRY_FOLLOW_THROUGH_MIN_CONFIRMATIONS=4
ENTRY_FOLLOW_THROUGH_RETURN_15S_PCT=0.00035
ENTRY_FOLLOW_THROUGH_RETURN_60S_PCT=0.00060
ENTRY_FOLLOW_THROUGH_PRESSURE=0.08
WEAK_NEUTRAL_SHORT_GATE_ENABLED=true
WEAK_NEUTRAL_SHORT_MIN_QUALITY=0.90
WEAK_NEUTRAL_SHORT_MIN_SEQUENCE_CONFIDENCE=0.94
WEAK_NEUTRAL_SHORT_MIN_FOLLOW_SCORE=0.95
WEAK_NEUTRAL_LONG_GATE_ENABLED=true
WEAK_NEUTRAL_LONG_MIN_QUALITY=0.82
WEAK_NEUTRAL_LONG_MIN_SEQUENCE_CONFIDENCE=0.94
WEAK_NEUTRAL_LONG_MIN_FOLLOW_SCORE=0.98
WEAK_NEUTRAL_LONG_MIN_1H_TREND_SCORE=0.25
WEAK_NEUTRAL_LONG_MIN_1H_RETURN_PCT=0.0025
EXIT_SHADOW_ENABLED=true
EXIT_SHADOW_FEE_TRAIL_ACTIVATION_FEE_MULTIPLE=1.50
EXIT_SHADOW_FEE_TRAIL_FLOOR_FEE_MULTIPLE=1.05
EXIT_SHADOW_MFE_TRAIL_ACTIVATION_PCT=0.0015
EXIT_SHADOW_MFE_TRAIL_DISTANCE_PCT=0.0010
EXIT_SHADOW_PARTIAL_TAKE_PROFIT_PCT=0.0010
EXIT_SHADOW_PARTIAL_TAKE_PROFIT_ALT_PCT=0.0015
EXIT_SHADOW_PARTIAL_FRACTION=0.50
EXIT_SHADOW_TIME_DECAY_SECONDS=180
EXIT_SHADOW_TIME_DECAY_MIN_MFE_FEE_MULTIPLE=1.25
PAPER_EXIT_POLICY=mfe_trailing_stop
PAPER_MFE_TRAILING_PROFILES=htf_aligned_fast,eth_counter_htf_bounce
ENABLE_PRICE_STOP=true
EMERGENCY_MAX_ADVERSE_MOVE_PCT=0.004
MAX_POSITION_SECONDS=0
MAX_SHORT_TAKER_BUY_RATIO_30S=0.60
ENABLE_FAST_FAILURE_EXIT=false
FAST_FAILURE_SECONDS=180
FAST_FAILURE_MIN_FAVORABLE_MOVE_PCT=0.0005
TRADE_COOLDOWN_SECONDS=1800
MAKER_REVERSION_SHADOW_ENABLED=true

# Paper model. This repo still does not place live orders.
ACCOUNT_EQUITY_USD=1000
STAKE_FRACTION=0.15
FAST_LEVERAGE=200
SLOW_LEVERAGE=80
TAKER_FEE_BPS=4.0
DAILY_TARGET_USD=150
DAILY_MAX_LOSS_USD=75
MAX_TRADES_PER_DAY=0

# Set this before exposing API endpoints beyond your own IP/VPN.
API_TOKEN=change-me-before-deploy

# Future demo/live keys. Do not commit real keys.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=
