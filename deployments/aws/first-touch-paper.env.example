APP_ENV=prod
SYMBOL=ETHUSDT
DATA_DIR=/app/data/runs/recon_48h_eth_first_touch_clean_TIMESTAMP

STRATEGY_VARIANT=first_touch_micro_momentum
ACCOUNT_EQUITY_USD=100
STAKE_FRACTION=0.033
FIRST_TOUCH_TARGET_MOVE_PCT=0.0060
FIRST_TOUCH_STOP_MOVE_PCT=0.0070
FIRST_TOUCH_LEVERAGE=150
FIRST_TOUCH_WARMUP_SECONDS=15
FIRST_TOUCH_MIN_ABS_MICRO_SIGNAL=0.0
MIN_CONFIDENCE=0.50
MAX_ACCOUNT_RISK_PER_TRADE_FRACTION=0.05

ENABLE_PRICE_STOP=true
ENABLE_FAST_FAILURE_EXIT=false
EMERGENCY_MAX_ADVERSE_MOVE_PCT=0.0070
PAPER_EXIT_POLICY=fixed_tp_stop
MAX_POSITION_SECONDS=21600
TRADE_COOLDOWN_SECONDS=60
MAX_TRADES_PER_DAY=0
DAILY_TARGET_USD=1000
DAILY_MAX_LOSS_USD=1000

TAKER_FEE_BPS=5.0
MAKER_FEE_BPS=2.0
EXPECTED_SLIPPAGE_BPS=0.5
LATENCY_ADVERSE_SELECTION_BPS=0.5
DEFAULT_ENTRY_ORDER_TYPE=taker
DEFAULT_EXIT_ORDER_TYPE=taker
MIN_GROSS_TARGET_FEE_MULTIPLE=2.0

EDGE_ROUTER_SHADOW_ENABLED=false
PAPER_LIVE_EDGE_GATE_ENABLED=false
PAPER_LIVE_ROLLING_EDGE_MONITOR_ENABLED=false
ENABLE_MARKOV_STATE_MACHINE=false
HIGHER_TIMEFRAME_ENABLED=false
CROSS_MARKET_ENABLED=false
OPEN_INTEREST_POLL_SECONDS=0

BINANCE_STREAM_PROFILE=hot-split
DEPTH_UPDATE_SPEED_MS=500
CONSUME_BOOK_TICKER_STREAM=false
CONSUME_DEPTH_STREAM=true
CONSUME_DEPTH_TOP_BOOK_MIN_INTERVAL_MS=500
CONSUME_LIQUIDATION_STREAM=false
RECORD_RAW_WS=true
RECORD_AGG_TRADE_STREAM=false
RAW_ROTATION_MINUTES=60
COMPRESS_ROTATED_RAW=true
MAX_EXCHANGE_EVENT_LAG_MS=2000
SHUTDOWN_TIMEOUT_SECONDS=30

DECISION_INTERVAL_MS=1000
WRITE_FEATURE_LOG=true
FEATURE_LOG_SAMPLE_INTERVAL=60
WRITE_DECISION_LOG=true
DECISION_LOG_WAIT_SAMPLE_INTERVAL=60
WRITE_PAPER_TRADE_LOG=true
WRITE_SHADOW_TRADE_LOG=false
WRITE_REGIME_OUTCOME_LOG=false
WRITE_CANDIDATE_OUTCOME_LOG=false
